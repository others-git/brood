{
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "brood hook", "timeout": 20 }] }],
    "PreToolUse": [{ "matcher": "Agent|Task|Bash|Read|Edit|Write|MultiEdit|NotebookEdit|WebFetch", "hooks": [{ "type": "command", "command": "brood hook", "timeout": 10 }] }],
    "PostToolUse": [{ "matcher": "WebFetch|WebSearch|mcp__.*", "hooks": [{ "type": "command", "command": "brood hook", "timeout": 10 }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "brood hook", "timeout": 10 }] }],
    "SubagentStop": [{ "hooks": [{ "type": "command", "command": "brood hook", "timeout": 20 }] }],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "brood hook", "timeout": 20 }] }]
  }
}
